{
  admin off
}

# Local Cloudflare source allowlist and origin certificates stay outside Git.
import /etc/caddy/cloudflare.caddy

https://ipinfo.dog {
  tls /certs/origin.crt /certs/origin.key
  route {
    import cloudflare_only
    header {
      Cache-Control "private, no-store, no-transform"
      CDN-Cache-Control "no-store"
      Cloudflare-CDN-Cache-Control "no-store"
    }
    @api path /api /api/*
    respond @api 404
    reverse_proxy 127.0.0.1:3002 {
      header_up -X-IPinfo-*
    }
  }
}

https://api.ipinfo.dog {
  tls /certs/origin.crt /certs/origin.key
  route {
    import cloudflare_only
    header {
      Cache-Control "private, no-store, no-transform"
      CDN-Cache-Control "no-store"
      Cloudflare-CDN-Cache-Control "no-store"
    }
    @connection path /api/connection
    handle @connection {
      reverse_proxy 127.0.0.1:3002 {
        import /certs/exit-proxy.caddy
        header_up X-IPinfo-Address {http.request.header.CF-Connecting-IP}
      }
    }
    @core path /api/ip /api/data-status /api/health /api/health/live
    handle @core {
      reverse_proxy 127.0.0.1:3002 {
        header_up -X-IPinfo-*
      }
    }
    handle {
      respond 404
    }
  }
}
