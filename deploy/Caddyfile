{
  admin off
  servers {
    import /etc/caddy/cloudflare.caddy
  }
}

# Public certificates are managed by Caddy. The local import contains only
# trusted_proxies (Cloudflare CIDRs) and client_ip_headers CF-Connecting-IP.
# Direct clients use their transport address; forwarded headers are not trusted.

https://ipinfo.dog {
  route {
    header {
      Cache-Control "private, no-store, no-transform"
      CDN-Cache-Control "no-store"
      Cloudflare-CDN-Cache-Control "no-store"
    }
    # Only the content-hashed navigation artwork is reusable across visits.
    @headerLogo path /_next/static/media/header-logo.*.webp
    header @headerLogo Cache-Control "public, max-age=31536000, immutable" {
      match status 200 304
    }
    @api path /api /api/*
    respond @api 404
    reverse_proxy 127.0.0.1:3002 {
      header_up -X-IPinfo-*
    }
  }
}

https://api.ipinfo.dog {
  route {
    header {
      Cache-Control "private, no-store, no-transform"
      CDN-Cache-Control "no-store"
      Cloudflare-CDN-Cache-Control "no-store"
    }
    @connection path /api/connection
    handle @connection {
      reverse_proxy 127.0.0.1:3002 {
        import /certs/exit-proxy.caddy
        header_up X-IPinfo-Address {client_ip}
      }
    }
    @core path /api/provider-icon /api/ip /api/ip/sources /api/data-status /api/health /api/health/live
    handle @core {
      reverse_proxy 127.0.0.1:3002 {
        header_up -X-IPinfo-*
      }
    }
    handle {
      respond 404
    }
  }
}
