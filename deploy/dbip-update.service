[Unit]
Description=Check DB-IP Lite monthly MMDB generation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The local EnvironmentFile supplies image and data path, not API tokens.
EnvironmentFile=/etc/ipinfo-dog/dbip-update.env
# Install the release's run-dbip-update.sh at this path before enabling.
ExecStart=/usr/bin/flock -n /run/lock/ipinfo-dbip-update.lock /usr/local/libexec/ipinfo-dbip-update
TimeoutStartSec=300
NoNewPrivileges=true
