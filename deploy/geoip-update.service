[Unit]
Description=IPinfo.dog validated GeoLite2 update
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/ipinfo-geoip-update.env
ExecStart=/usr/local/libexec/ipinfo-geoip-update
TimeoutStartSec=15min
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
