# Local MaxMind database directory; production uses read-only managed files.
GEOIP_DATABASE_DIR=./data/maxmind

# Managed IPinfo Lite data only; the web app never reads a download credential.
IPINFO_DATABASE_DIR=./data/ipinfo
# Used by the separate update command only. Do not use NEXT_PUBLIC_.
IPINFO_LITE_TOKEN=
IPINFO_LITE_TOKEN_FILE=
