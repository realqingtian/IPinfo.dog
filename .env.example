# Three local MMDB files; never use a browser-exposed NEXT_PUBLIC variable.
GEOIP_DATABASE_DIR=./data/maxmind

# IPinfo Lite API token. Server-side only; put the real value in ignored .env.
# Never prefix a credential with NEXT_PUBLIC_. Keep this example empty.
IPINFO_LITE_TOKEN=
# Production may provide a read-only file instead of a token in the environment.
IPINFO_LITE_TOKEN_FILE=
# Separate DB-IP Lite release directory, outside the image. Run dbip:update first.
DBIP_DATABASE_DIR=./data/dbip
